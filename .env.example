# Werte für den lokalen MySQL-Container (docker-compose.yml)
DB_NAME=muenevver
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DB_PORT=3307

# Von der App genutzte Verbindung (Drizzle/mysql2) - muss zu den Werten oben passen.
# Auf dem Zielserver einfach durch die dortige MySQL-Verbindung ersetzen.
DATABASE_URL=mysql://app:app@localhost:3307/muenevver

# Session-Cookie-Verschluesselung (nuxt-auth-utils) - mind. 32 Zeichen, zufaellig.
# Erzeugen z.B. mit: openssl rand -hex 32
NUXT_SESSION_PASSWORD=bitte-lokal-durch-32-zufaellige-zeichen-ersetzen

# Ordner fuer hochgeladene Bilder (relativ zum Projektverzeichnis, lokal reicht das)
UPLOADS_DIR=.data/uploads

# Resend (https://resend.com) fuer die Tagebuch-Benachrichtigungsmails.
# Fuer die lokale Entwicklung kann das leer bleiben - Mails werden dann nur geloggt, nicht verschickt.
RESEND_API_KEY=
RESEND_FROM=
