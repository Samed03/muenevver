# Vorlage für die .env-Datei auf dem Server (unter /opt/muenevver/.env).
# Wichtig: eigene, starke Passwoerter verwenden, nicht die lokalen Dev-Werte!

# Welches Docker-Image gepullt werden soll (dein GitHub-Repo, klein geschrieben)
IMAGE_NAME=ghcr.io/DEIN-GITHUB-USER/DEIN-REPO-NAME

DB_NAME=muenevver
DB_USER=app
DB_PASSWORD=BITTE-AENDERN
DB_ROOT_PASSWORD=BITTE-AENDERN

# Verbindung, die die App selbst nutzt (Host "db" = Docker-Compose-Servicename, nicht localhost!)
DATABASE_URL=mysql://app:BITTE-AENDERN@db:3306/muenevver

# Session-Cookie-Verschluesselung (nuxt-auth-utils) - mind. 32 Zeichen, zufaellig, geheim halten.
# Erzeugen z.B. mit: openssl rand -hex 32
NUXT_SESSION_PASSWORD=BITTE-AENDERN-32-ZUFAELLIGE-ZEICHEN

# Ordner fuer hochgeladene Bilder im Container (siehe Volume "uploads-data" in docker-compose.prod.yml)
UPLOADS_DIR=/app/.data/uploads

# Resend (https://resend.com): API-Key aus dem Resend-Dashboard, FROM-Adresse mit
# verifizierter Domain (sonst kann Resend ggf. nur an die eigene Account-Mail zustellen).
RESEND_API_KEY=BITTE-AENDERN
RESEND_FROM=Muenevver <noreply@samedarslan.de>
